# ----- Aplicação -----
APP_ENV=local
APP_URL=http://localhost/checkout-infinitepay

# simulation = gateway simulado (sem dinheiro) | real = InfinitePay de verdade
PAYMENT_MODE=simulation

# ----- Banco de dados -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=checkout_infinitepay
DB_USER=root
DB_PASS=

# ----- InfinitePay (Checkout Integrado) -----
# InfiniteTag SEM o simbolo $
INFINITEPAY_HANDLE=
# Chave secreta (comeca com inchk_). Nunca coloque no JavaScript nem no Git.
INFINITEPAY_API_KEY=
INFINITEPAY_BASE_URL=https://api.checkout.infinitepay.io
INFINITEPAY_TIMEOUT=15

# Somente quando houver um tunel HTTPS publico (ngrok, Cloudflare Tunnel...)
INFINITEPAY_WEBHOOK_URL=